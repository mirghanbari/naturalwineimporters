{
  "name": "naturalwineimporters",
  "main": "src/index.js",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "naturalwineimporters.com", "custom_domain": true },
    { "pattern": "www.naturalwineimporters.com", "custom_domain": true }
  ]
}
